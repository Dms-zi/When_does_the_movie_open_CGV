{
  "name": "uijeongbu-movie-alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/worker.mjs && node --check public/app.js && node --check public/sw.js",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "db:local": "wrangler d1 migrations apply cgv-alerts --local",
    "db:remote": "wrangler d1 migrations apply cgv-alerts --remote",
    "deploy": "wrangler deploy",
    "keys": "node scripts/generate-keys.mjs",
    "verify:cgv": "node scripts/verify-cgv.mjs",
    "db:generate": "drizzle-kit generate",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "wrangler": "4.158.0"
  }
}
